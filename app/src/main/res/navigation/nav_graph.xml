<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/nav_home_fragment">

    <fragment
        android:id="@+id/nav_home_fragment"
        android:name="com.sap.codelab.presentation.home.HomeFragment"
        android:label="@string/nav_home_label"
        tools:layout="@layout/fragment_home" >
        <action
            android:id="@+id/action_nav_home_fragment_to_nav_create_memo_fragment"
            app:destination="@id/nav_create_memo_fragment" />
        <action
            android:id="@+id/action_nav_home_fragment_to_nav_memo_details_fragment"
            app:destination="@id/nav_memo_details_fragment" />
    </fragment>
    <fragment
        android:id="@+id/nav_create_memo_fragment"
        android:name="com.sap.codelab.presentation.create.CreateMemoFragment"
        android:label="@string/nav_create_memo_label"
        tools:layout="@layout/fragment_create_memo" >
        <action
            android:id="@+id/action_nav_create_memo_fragment_to_nav_select_location_fragment"
            app:destination="@id/nav_select_location_fragment" />
    </fragment>
    <fragment
        android:id="@+id/nav_memo_details_fragment"
        android:name="com.sap.codelab.presentation.details.MemoDetailsFragment"
        android:label="@string/nav_memo_details_label"
        tools:layout="@layout/fragment_memo_details">
        <argument
            android:name="memoId"
            app:argType="long" />
    </fragment>
    <fragment
        android:id="@+id/nav_select_location_fragment"
        android:name="com.sap.codelab.presentation.location.SelectLocationFragment"
        android:label="@string/nav_select_location_label"
        tools:layout="@layout/fragment_select_location" />
</navigation>